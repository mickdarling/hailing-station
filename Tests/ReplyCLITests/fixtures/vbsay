#!/usr/bin/python3
# Synthetic PCM only: never invoke a real speech provider or audio device.
import json
import os
import stat
import time
from pathlib import Path

assert os.environ["VBSAY_NOPLAY"] == "1"
output = Path(os.environ["VBSAY_OUT"])
# Segment tests record only invocation numbers, process IDs and timing, never renderer input.
invocation = 1
if "REPLY_RENDERER_TEST_INVOCATIONS" in os.environ:
    record = Path(os.environ["REPLY_RENDERER_TEST_INVOCATIONS"])
    invocation = len(record.read_text().splitlines()) + 1 if record.exists() else 1
    with record.open("a") as handle:
        handle.write(json.dumps({"index": invocation, "pid": os.getpid(), "owner": os.getppid(), "started": time.monotonic()}) + "\n")
if os.environ.get("REPLY_RENDERER_TEST_FAIL_SEGMENT") == str(invocation):
    if os.environ.get("REPLY_RENDERER_TEST_RETAIN_FAILED_OUTPUT"):
        (output / "synthetic.raw").write_bytes(bytes(4))
    raise SystemExit(23)
if "REPLY_RENDERER_TEST_RECORD" in os.environ:
    root = Path(os.environ["REPLY_RENDERER_TEST_ROOT"])
    Path(os.environ["REPLY_RENDERER_TEST_RECORD"]).write_text(json.dumps({
        "same_group_as_cli": os.getpgrp() == os.getpgid(os.getppid()),
        "output_under_explicit_root": output.resolve().is_relative_to(root.resolve()),
        "private_output": stat.S_IMODE(output.stat().st_mode) == 0o700,
        "private_root": stat.S_IMODE(root.stat().st_mode) == 0o700,
    }))
if "REPLY_RENDERER_TEST_PIDFILE" in os.environ:
    Path(os.environ["REPLY_RENDERER_TEST_PIDFILE"]).write_text(str(os.getpid()))
if os.environ.get("REPLY_RENDERER_TEST_STALL"):
    import time
    time.sleep(60)  # a renderer that never writes: only a signal ends it
    raise SystemExit(0)
if os.environ.get("REPLY_RENDERER_TEST_NONZERO"):
    raise SystemExit(23)
if "REPLY_RENDERER_TEST_STDOUT_BYTES" in os.environ:
    assert os.environ["VBSAY_STDOUT"] == "1"
    counts = os.environ["REPLY_RENDERER_TEST_STDOUT_BYTES"].split(",")
    count = int(counts[min(invocation - 1, len(counts) - 1)])
    value = invocation if os.environ.get("REPLY_RENDERER_TEST_SEGMENT_BYTES") else 0
    for start in range(0, count, 7_000):
        os.write(1, bytes([value]) * min(7_000, count - start))
    if os.environ.get("REPLY_RENDERER_TEST_STALL_AFTER_BYTES"):
        time.sleep(60)
    raise SystemExit(0)
(output / "synthetic.raw").write_bytes(bytes([0, 0, 1, 0]))
